  environmentDefault  String   @default("interior")
  exposureDefault     String   @default("concealed")
  resolverProfileJson String?  // JSON config overrides for WiringMethodResolver
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
}

model Lead {
  priceBookDrafts   PriceBookDraftEstimate[]
  id                String    @id @default(cuid())
  name              String
  email             String?
  phone             String?
  source            String    @default("email")   // email | phone | web | manual | referral | savannah_text | retention
  status            String    @default("new")     // "new" | "contacted" | "converted" | "lost"
  notes             String?
  // ── Address, two tracks ──
  // `address` is free text the phone/email intake fills. Conversion parses it
  // with a regex that needs exactly "line1, city, ST 12345" — a fallback that
  // exists only for those callers.
  //
  // The five structured columns are what the CRM's manual form fills, and
  // conversion consumes them verbatim with no parsing. They are all-or-nothing:
  // a lead either has a complete structured address or none, which is what stops
  // a Property being created with empty-string city/state/ZIP.
  address           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  jobType           String?
  callType          String?  // "new_job" | "warranty" | "reschedule" | "cancellation" | "estimate_followup" | "callback" | "vendor" | "referral" | "invoice" | "dispute" | "wrong_number" | "solicitation" | "other"
  referredBy        String?
  urgentFlag        Boolean   @default(false)
  warrantyCall      Boolean   @default(false)
  warrantyNote      String?
  // ── Follow-up & pipeline fields (Phase 1 data model) ──
  contactPreference String?   // "phone" | "email" | "either"
  // Tri-state: true = checked the consent box on the website form, false =
  // explicitly declined (box shown, left unchecked on a web lead), null = never
  // asked (phone/email/manual leads). This is the record A2P registration
  // attests to — the website checkbox is the only opt-in channel, so only
  // `true` clears the send gate in services/twilio.ts; null does NOT.
  smsConsent        Boolean?
  leadStatus        String    @default("new") // "new" | "booked" | "unresolved" | "planning" | "no_answer" | "lost" | "won"
  followUpDate      DateTime?
  followUpReason    String?   // "comparing_estimates" | "still_planning" | "consulting_partner" | "no_answer"
  followUpCount     Int       @default(0)
  lostReason        String?   // "price" | "timing" | "referral" | "trust" | "scope" | "other"
  lostNotes         String?   // internal only — verbatim customer feedback, never shared
  bestTimeToReach   String?   // free text, e.g. "mornings" or "after 3pm"
  // ── Existing linking fields ──
  estimateId        String?
  existingVisitId   String?
  customerId        String?
  propertyId        String?
  visitId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId])
  @@index([leadStatus, followUpDate])
  @@index([phone])
  @@index([createdAt])
}

// ─── PHASE 1 DATA MODEL — NEW MODELS ────────────────────────────────────────

// ─── Financials (Kyle, 2026-08-25) ───────────────────────────────────────────
//
// "A new tab dedicated to financial tracking of each job that will produce
// necessary accounting reports for the company, I will enter all company bills
// and rolling costs and revenue in here."
//
// Company bills are the RECURRING side of expenses (insurance, phone, software,
// truck payment); one-off spends stay on Receipt, which already carries the
// materials/gas/maintenance/overhead categories. Reports read both.

model CompanyBill {
  id         String    @id @default(cuid())
  name       String    // "General liability insurance", "Truck payment"
  category   String    @default("overhead") // overhead | insurance | vehicle | software | marketing | other
  amount     Float
  // one_time bills hit their billDate's month once; recurring bills hit every
  // period from startDate until endDate (or forever while endDate is null).
  cadence    String    // one_time | weekly | monthly | quarterly | annual
  billDate   DateTime? // one_time: the month it lands in
  startDate  DateTime? // recurring: first period
  endDate    DateTime? // recurring: null = still active
  notes      String?
  createdAt  DateTime  @default(now())
}

// Money actually received. Stripe payments arrive via webhook; cash and checks
// are recorded by hand. Revenue reports show invoiced (signed estimates) and
// collected (these rows) side by side — accrual and cash views of the same jobs.
model Payment {
  id              String    @id @default(cuid())
  customerId      String?
  estimateId      String?   // IssuedEstimate id — plain column, provenance
  visitId         String?
  amount          Float
  method          String    // stripe | cash | check | other
  // What the money was FOR (Kyle, 2026-08-25: "a 1/3 deposit on every job.
  // Deposit required before it can be scheduled"). deposit | final | other.
  // The scheduling gate reads paid deposit rows; the final pay link charges
  // the balance net of everything already paid.
  kind            String    @default("other")
  status          String    @default("paid") // pending | paid | failed | refunded
  stripeSessionId String?   @unique
  note            String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@index([estimateId])
}

model Receipt {
  id           String   @id @default(cuid())
  jobId        String?  // visit ID — null for overhead/gas not tied to a specific job
  category     String   // "materials" | "gas" | "maintenance" | "overhead"
  vendor       String?
  amount       Float
  lineItems    String?  // JSON array: [{name, qty, unit, unitCost}]
  imageUrl     String?
  // ── Capture provenance & review workflow ──
  source       String   @default("webhook") // webhook | tech_pwa | mms | manual
  status       String   @default("confirmed") // pending_review | confirmed
  technicianId String?  // who captured it (tech PWA or matched MMS sender)
  imageData    Bytes?   // original receipt photo — rides DB backups like InspectionPhoto
  imageMime    String?
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  // The account summary pulls receipts by job id across an account's whole history.
  @@index([jobId])
}

model Document {
  id           String    @id @default(cuid())
  // Nullable since the ledger: a cure certificate for work a third party did has
  // no Red Cedar visit to hang on, and inventing a synthetic Visit would pollute
  // the Jobs list and every calendar and revenue rollup built on it.
  jobId        String?   // visit ID
  propertyId   String?   // set when the document belongs to an address, not a job
  type         String    // "work_order" | "material_list" | "contract" | "change_order" | "signed" | "cure_certificate" | "upgrade_record" | "finding_declination"
  pdfUrl       String
  signedAt     DateTime?
  signedByIp   String?
  signedByName String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  // ── The signed estimate, filed on the account (Kyle, 2026-08-20) ──
  //
  // "When they sign I should get a notification and a copy of the signed agreement to their
  //  account too."
  //
  // The bytes are NOT stored. `pdfUrl` on every other document type is a path into `generated/`,
  // which Railway discards on each deploy — those documents stop resolving after the next
  // release. A signed agreement is the last thing that should evaporate, so this one points at
  // the immutable estimate and the PDF is rendered from it on request. Same document every time,
  // and nothing to lose.
  issuedEstimateId String?
  issuedEstimate   IssuedEstimate? @relation(fields: [issuedEstimateId], references: [id], onDelete: Cascade)

  job          Visit?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type])
  @@index([issuedEstimateId])
}

model MaterialOrder {
  id         String    @id @default(cuid())
  jobId      String    // visit ID
  supplier   String
  items      String    // JSON array: [{name, qty, unit, partNumber?}]
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  job        Visit     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// Job-site photo uploaded from the tech PWA. Client-generated UUID id makes
// offline-queue retries idempotent (same pattern as InspectionPhoto). Stored
// in Postgres so evidence rides the managed backups.
model VisitPhoto {
  id           String      @id // client-generated UUID — idempotency key
  visitId      String
  technicianId String?
  mimeType     String
  sizeBytes    Int
  caption      String?
  // Gallery category (Kyle, 2026-08-28): before | after | assessment | reference.
  // Nullable — photos from before the gallery simply have no tag.
  tag          String?
  data         Bytes
  uploadedAt   DateTime    @default(now())
  visit        Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([visitId])
}

// Audit log of every inbound SMS/MMS hitting the Twilio webhook — who it
// matched (customer / tech / Kyle / unknown) and how it was routed.
model InboundMessage {
  id        String   @id @default(cuid())
  fromPhone String
  body      String
  numMedia  Int      @default(0)
  matchType String   // kyle | customer | technician | unknown
  matchId   String?  // customerId or technicianId when matched
  handledAs String?  // confirmation_reply | tech_note | receipt | forwarded | kyle_dispatch | ignored
  createdAt DateTime @default(now())

  @@index([fromPhone, createdAt])
}

model AgentAuditLog {
  id              String   @id @default(cuid())
  action          String
  agent           String?  // "savannah" | "jerry"
  endpoint        String?
  visitId         String?
  entityType      String?
  entityId        String?
  payloadJson     String?
  responseStatus  Int?
  durationMs      Int?
  clientRequestId String?
  // Vapi's own call.id, threaded through from the tool request (header
  // x-vapi-call-id) — lets /vapi/end-of-call-report check whether THIS call
  // already got a disposition logged, independent of model behavior.
  callId          String?
  createdAt       DateTime @default(now())

  @@index([action, callId])
}

// ─── System events ─────────────────────────────────────────────────────────
//
// Persistent, queryable error/event log. console.error scrolls away in Railway
// and is invisible to the coding agent auditing the system; this table is what
// scripts/readSystemEvents.ts reads (via `railway run`) when diagnosing
// production. Also the sink for the CRM's feedback box (source = "feedback"),
// so operator reports land next to the correlated errors, timestamped.
//
// Writes are fire-and-forget (services/systemEvents.ts) — logging must never
// take down the operation being logged.
model SystemEvent {
  id          String   @id @default(cuid())
  level       String   // "error" | "warn" | "info"
  source      String   // "express" | "twilio" | "google_calendar" | "feedback" | "cron" | ...
  message     String
  route       String?  // HTTP method + path when the event came from a request
  detailsJson String?  // stack trace, request context, feedback page/context
  createdAt   DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}

model AgentIdempotency {
  id              String   @id @default(cuid())
  clientRequestId String
  endpoint        String
  agent           String?  // "savannah" | "jerry"
  visitId         String?
  responseJson    String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([clientRequestId, endpoint])
}

model ChatMessage {
  id               String   @id @default(cuid())
  sessionId        String
  visitId          String?
  role             String   // "user" | "assistant"
  content          String
  openaiResponseId String?
  createdAt        DateTime @default(now())

  @@index([visitId, createdAt])
  @@index([sessionId, createdAt])
}

// ─── PRICE BOOK CATALOG (imported from price-book.xlsx) ─────────────────────
//
// Mirror of the estimating workbook Kyle's 02:00 and 03:03 scheduled tasks maintain.
// THE WORKBOOK IS THE SOURCE OF TRUTH AND THIS MIRROR MUST NEVER LEAD IT — the import
// is one-way and read-only against the file (scripts/price-book/).
//
// WHY THESE ARE NOT AtomicUnit / AssemblyTemplate / AssemblyTemplateComponent.
// Reported rather than assumed, per the Phase 1 prompt's instruction to map to the
// existing schema or say why it cannot carry the workbook's shape. Four blockers, any
// one of which is sufficient:
//
//  1. DIFFICULTY. The workbook stores THREE labour values per atomic — Normal,
//     Difficult, Very Difficult — read verbatim from the NECA manual. The existing
//     model carries one `baseLaborHrs` and expresses difficulty as a GLOBAL
//     ModifierDef multiplier (1.25 / 1.50). Those are not equivalent and the workbook
//     proved it: an audit of 59 standard-curve rows found 20 whose published Difficult
//     and Very Difficult values are NOT Normal x1.25 / x1.50, and N008's Kyle-set
//     triple is 0.50 / 0.75 / 1.00, where a x1.25 multiplier would return 0.625 hr
//     against three assemblies that hardcode 0.75. Importing into a multiplier model
//     would fabricate labour values — the exact defect F-2026-08-11-02 caught.
//
//  2. SUPPLIER-RESOLVED COST. `AtomicUnit.baseMaterialCost` is a single Float with a
//     default of 0. The workbook's cost is a lookup against a per-supplier price table
//     gated on a quotability flag, with NO fallback, and its ABSENCE is meaningful
//     ("the active supplier does not carry this"). A non-null Float defaulting to 0
//     cannot represent "absent" — it reports free.
//
//  3. QUOTABILITY. Nothing in the existing model can express NOT QUOTABLE, so nothing
//     stops a quarantined employer-account price reaching a customer number.
//
//  4. LIVE COLLISION. `scripts/seedAtomicUnits.ts` runs on every deploy (see the
//     `start` script) and begins by setting isActive=false on EVERY AtomicUnit row
//     before reactivating only the three CSV catalogs. Importing the workbook into
//     that table would silently deactivate the entire price book on the next deploy.
//
// The existing atomic/assembly models are left untouched and keep serving the CSV
// catalog they were built for.

enum PriceBookQuotable {
  YES
  NO
  NEVER // employer-account / quarantined — may never reach a customer price
}

// One row per import execution. The delta report on disk is the human artifact; this
// is the queryable one, and it is what makes "when did this price change and which run
// changed it" answerable without diffing markdown.
model PriceBookImportRun {
  id                String   @id @default(cuid())
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  status            String   // running | success | failed
  // SHA-256 of the workbook as read. Two runs with the same hash saw the same file.
  workbookSha256    String
  workbookPath      String
  workbookMtime     DateTime?
  mappingVersion    String
  // Rate Config B2 as found. Kyle's standing ruling is $150/hr
  // (decisions/2026-08-11-billed-rate-and-no-memberships.md). The cell is applied by
  // the 02:00 task, not by this pipeline, so a mismatch marks the import PROVISIONAL
  // rather than overriding the number — an agent may not set a number (who-sets-numbers).
  billedLaborRate   Float?
  provisional       Boolean  @default(false)
  provisionalReason String?
  activeSupplierId  String?
  countsJson        String?  // created/updated/unchanged/missing per entity
  parityRan         Boolean  @default(false)
  parityPassed      Boolean?
  parityJson        String?
  deltaReportPath   String?
  errorMessage      String?

  @@index([startedAt])
}

model PriceBookSupplier {
  id           String            @id // workbook Supplier ID, e.g. "HD"
  name         String
  branch       String?
  channel      String? // "A" = same-day retail, "B" = supply-house will-call
  accountClass String? // RCE-CASH | EMPLOYER-ACCT | NO-ACCOUNT
  // Enum, not a string: the quarantine has to be structural. "NO — NEVER" in the
  // workbook maps to NEVER and nothing in the pricing path will resolve against it.
  quotable     PriceBookQuotable
  quotableRaw  String? // the workbook's exact wording, kept for audit
  leadTime     String?
  terms        String?
  notes        String?
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @updatedAt
  prices       PriceBookSupplierPrice[]
}

// One row per Item ID x Supplier, mirroring the workbook's normalised `Supplier Prices`
// tab. `unitCost` is the workbook's own column F arithmetic: /c divides by 100, /m by
// 1000, otherwise by Pack Qty.
model PriceBookSupplierPrice {
  id              String            @id @default(cuid())
  itemId          String
  supplierId      String
  priceAsPrinted  Float?
  pricedUom       String?
  packQty         Float?
  unitCost        Float? // null = no usable price. NEVER 0-for-absent.
  datePriced      String?
  source          String?
  availability    String?
  accountClass    String?
  quotable        PriceBookQuotable
  quotableRaw     String?
  // The workbook's structural quarantine: `=IF(K="YES", A&"|"&B, "")`. Blank here means
  // the cost lookup cannot match this row, so the price cannot reach a quote. Modelled
  // as a nullable unique key so the same guarantee holds in the database.
  quotableKey     String?           @unique
  confidence      String?
  notes           String?
  workbookRow     Int?
  lastSeenImportId String?
  supplier        PriceBookSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([itemId, supplierId])
  @@index([itemId])
  @@index([quotableKey])
}

model PriceBookAtomic {
  itemId             String  @id // "A016", "SD002" — the workbook's own stable ID
  description        String?
  category           String?
  sector             String? // Residential | Light Commercial | Both
  unit               String? // ea | ft | sq ft | hr
  rowType            String? // MATERIAL + LABOR | LABOR ONLY | MATERIAL ONLY | ...

  // Three published labour values, stored as three values. All nullable: a blank
  // labour cell means NECA publishes no unit for this product (GB001, DF013), and
  // that is a finding, not a zero.
  laborNormal        Float?
  laborDifficult     Float?
  laborVeryDifficult Float?
  difficultyCurve    String?
  laborStatus        String?
  necaUnitBasis      String?
  necaPdfPage        String?

  // ── NECA labour unit basis (Atomics!AA, added by the 04:00 task 2026-08-13) ──
  // E = per each · C = per hundred · M = per thousand. HOURS = qty x labour / divisor.
  // NULL means the workbook has NOT established a basis for this row ("UNVERIFIED"), and a
  // null MUST block the line rather than default to E — the column header says so verbatim,
  // and the difference between E and C is a 100x labour error that still looks plausible.
  // laborUnitBasisRaw keeps the workbook's exact wording, including its source citation.
  laborUnitBasis     String? // "E" | "C" | "M" | null
  laborUnitDivisor   Float?  // 1 | 100 | 1000 | null
  laborUnitBasisRaw  String?

  // Reference-only historical columns. The live cost is resolved from
  // PriceBookSupplierPrice at the active supplier — these are NOT the quote basis.
  retailCost         Float?
  tradeCost          Float?
  purchaseUnit       String?
  purchasePackQty    Float?
  purchasePrice      Float?

  // ── Resolved at import against the active supplier, mirroring Atomics!K/W/X ──
  // All nullable. A null costBasis is the workbook's blank: the active supplier does
  // not carry this item, the assembly reads incomplete, and no fallback is permitted.
  costBasisUsed      Float?
  costBasisSupplier  String?
  markupTier         String? // T1..T5 | "awaiting cost"
  sellPricePerUnit   Float?

  // ── KYLE'S TAB (P030). The catalog swap, 2026-08-18. ────────────────────────────────
  //
  // Kyle: "I want only my tab (Kyle's Copy) to be the source of truth." 226 items he built,
  // named, priced and tier-checked by hand.
  //
  // WHY THESE LAND ON THE EXISTING MODEL RATHER THAN A NEW ONE. `PriceBookDraftLine.itemId` and
  // `IssuedEstimateLine.itemId` are foreign keys to this table. A separate model would have meant
  // migrating both — and would have broken the two legacy drafts' references, which the prompt
  // requires be KEPT. Retiring in place preserves every existing edge; the old rows simply stop
  // being browsable.
  //
  // `sell*` ARE THE AUTHORITATIVE CUSTOMER PRICES. Kyle's sheet computes
  // `sell = labor x $150 + marked-up material` per difficulty and the import asserts it to the
  // cent, per row, refusing on any mismatch. Nothing recomputes them here.
  //
  // The labour columns above still carry per-unit HOURS for these rows — already resolved, so no
  // E/C/M basis exists or is needed (basis is written as E/divisor 1 so any hours-based reader
  // stays correct). Hours and the material split are INTERNAL, for job costing. Kyle's standing
  // rule — "Never show labor hour estimate to the customer" — is why the customer-facing models
  // carry none of this.
  source             String  @default("neca-workbook") // "kyles-tab" | "neca-workbook"
  sellNormal         Float?
  sellDifficult      Float?
  sellVeryDifficult  Float?
  companyCost        Float?  // internal: what it costs RCE
  companyPrice       Float?  // internal: tier-marked-up material, before labour
  // The unit is embedded in Kyle's item names ("- per ft", "- per box", "- per hour"); parsed out
  // once at import so a quantity field can say what it is counting.
  unitLabel          String?

  necArticle         String?
  notes              String?
  workbookRow        Int?    // provenance only — never used to resolve a component
  // In-app catalog editor (Kyle, 2026-08-30, Option A: the app IS the book now).
  // Second-level grouping under `category`; nullable — most items have none.
  subCategory        String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt
  // Set when an import no longer finds this ID. Rows are retired, never deleted
  // (write protocol rule 5: move, never delete).
  retiredAt          DateTime?
  components         PriceBookAssemblyComponent[]
  draftLines         PriceBookDraftLine[]
  issuedLines        IssuedEstimateLine[]

  @@index([category])
  @@index([retiredAt])
  @@index([source])
}

model PriceBookAssembly {
  assemblyId              String  @id // "AS-001"
  name                    String?
  sector                  String? // from the tab it was imported from
  useCase                 String?
  status                  String? // "Draft" | "SUPERSEDED ... DO NOT QUOTE"
  // True when Status marks the row superseded. Precomputed so the quote path tests a
  // boolean rather than re-parsing prose at estimate time.
  superseded              Boolean @default(false)

  // ── Labour ──
  // FROZEN LITERAL, AND THE PIPELINE SAYS SO RATHER THAN HIDING IT. Verified
  // 2026-08-11: 0 of 43 assembly labour formulas reference the Atomics tab; every one
  // is literal arithmetic (e.g. "=4*0.25+4*0.05+(4/100)*30+(4/100)*10"). An atomic's
  // labour change therefore does NOT propagate to any assembly. Material IS live-linked.
  // The value is imported verbatim so the app matches the workbook; the divergence
  // against an atomic-derived figure is reported as a finding, not silently corrected —
  // it is Kyle's number to move.
  totalLaborNormal        Float?
  totalLaborFormula       String?
  laborFormulaIsFrozen    Boolean @default(true)
  difficultySetting       String?
  fieldDifficulty         String? // NORMAL default — tech selects in the field

  // ── Job-level inputs (drive the adder arithmetic) ──
  permitRequiredRaw       String?
  utilityStandbyRaw       String?
  heightAccessAdderHours  Float?
  ceilingHeightBand       String?
  jobType                 String?
  sourcingChannel         String?

  // ── Workbook-computed snapshot, stored for the parity harness ──
  // These are what Excel produced from the workbook's own formulas at import time.
  // They are the ORACLE the app is checked against — never an input to app pricing.
  wbLaborHoursAdjusted    Float?
  wbLaborDollars          Float?
  wbMaterialCost          Float?
  wbMaterialSell          Float?
  wbJobAdderHours         Float?
  wbJobAdderDollars       Float?
  wbPermitFee             Float?
  wbTotalFlatRate         Float?
  wbComponentsUnpriced    Int?
  wbMaterialComplete      String?
  wbTotalJobHours         Float?
  wbJobFixedCost          Float?
  wbTotalWithFixedCost    Float?

  necCodeRefs             String?
  necCategory             String?
  pricingFlags            String?
  notes                   String?
  componentProse          String? // column E, human prose — NOT parsed for components
  componentsTotalDeclared Int?
  workbookRow             Int?
  firstSeenAt             DateTime @default(now())
  lastSeenAt              DateTime @updatedAt
  retiredAt               DateTime?
  components              PriceBookAssemblyComponent[]

  @@index([sector])
  @@index([superseded])
  @@index([retiredAt])
}

// Derived from the assembly's MATERIAL COST FORMULA, not from the human prose in
// column E — that column also lists the field-measured and walkthrough-counted items
// deliberately removed from the assembly, and parsing it would re-import exactly what
// Kyle's 2026-08-09 sweep took out.
model PriceBookAssemblyComponent {
  id         String @id @default(cuid())
  assemblyId String
  itemId     String
  quantity   Float
  // The Atomics row the workbook formula pointed at. Recorded because the workbook
  // references atomics BY ROW NUMBER: an inserted or deleted row silently repoints
  // every assembly below it with no Excel error. Provenance for that failure mode.
  atomicRow  Int?
  assembly   PriceBookAssembly @relation(fields: [assemblyId], references: [assemblyId], onDelete: Cascade)
  atomic     PriceBookAtomic   @relation(fields: [itemId], references: [itemId], onDelete: Restrict)

  @@unique([assemblyId, itemId, atomicRow])
  @@index([itemId])
}

// Rate Config as a key-value mirror. Kept keyed rather than flattened into columns so a
// new policy cell is an import change, not a migration.
model PriceBookRateConfig {
  key         String   @id // billedLaborRate, markupTier1, activeSupplier, ...
  label       String   // the workbook's own label text, asserted at import
  workbookRow Int
  numberValue Float?
  textValue   String?
  lastSeenAt  DateTime @updatedAt
}

// ─── In-app price book editor (Kyle, 2026-08-30) ─────────────────────────────
//
// Option A ratified: the app is the book now. Every edit lands here as an
// append-only audit row — a price a customer asks about needs a story, and
// "who changed what, when, from what to what" is that story. The workbook
// import lane remains for a final import; after that the export is the
// spreadsheet view, not the authority.

model PriceBookEdit {
  id        String   @id @default(cuid())
  itemId    String   // the atomic touched; "(category)" ops use the item rows they touched
  field     String   // "description" | "companyCost" | "laborNormal" | "category" | "created" | "retired" | "restored" | ...
  oldValue  String?
  newValue  String?
  editedBy  String   // "human:crm-session" until logins differentiate
  note      String?
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
}

// Display order for the catalog's category cards. A category exists by being
// named on an item; this row only orders (and survives renames by following
// them). No parent pointer — sub-categories live on the item (`subCategory`)
// and order alphabetically within their category.
model PriceBookCategoryMeta {
  name      String @id
  sortOrder Int    @default(0)
}

model PriceBookNecCategory {
  article    String   @id
  title      String?
  onKyleList String?
  scopeRule  String?
  lastSeenAt DateTime @updatedAt
}

// ─── ATOMIC-FIRST CUSTOM ESTIMATES (Phase 2.0) ──────────────────────────────
//
// Kyle, 2026-08-12 (decisions/2026-08-12-atomic-first-custom-estimates.md):
//   "estimating software that builds off of tech input that compares to the atomic units.
//    This will allow for any job to be fully customized to what is actually needed rather
//    than what is assumed."
//
// A draft estimate is a LIST OF LINES, each one a tech input against an atomic. There is no
// assembly here on purpose — the assembly is a bundle of assumptions, and this is the model
// that replaces assuming with asking.
//
// ADDITIVE ONLY. Nothing here touches Estimate / EstimateOption / EstimateItem /
// EstimateAssembly — the existing job-history models are untouched and unreferenced.

enum PriceBookDifficulty {
  NORMAL         // default; Kyle 2026-08-11 — difficulty is a FIELD OBSERVATION
  DIFFICULT
  VERY_DIFFICULT
}

// AI proposes / human confirms / engine prices — Kyle's control architecture, made structural.
//
// decisions/2026-08-04-who-sets-numbers.md: "The agent may compute, source, and recommend.
// It may not set." A PROPOSED line is the AI's recommendation and it contributes NOTHING to any
// total; only a human confirming it makes it a line the engine will price.
enum PriceBookLineState {
  PROPOSED
  CONFIRMED
}

// Where the line's quantity came from. This is not decoration: it is what lets the engine
// tell "the tech counted 4 receptacles" from "the tech measured 50 ft of EMT", and the
// measured case is the one Kyle's cable rule governs.
enum PriceBookQuantitySource {
  COUNT             // discrete items the tech counted
  MEASURED_LENGTH   // continuous-length product measured on site (Kyle: "Length is a field
                    // measurement and needs to be calculated separately")
  TERMINATION_COUNT // driven by how many terminations exist, not by run length
  MANUAL            // tech overrode the quantity; requires a note
}

model PriceBookDraftEstimate {
  id            String   @id @default(cuid())
  title         String

  // ── CONTEXT (P024, Option A of the P020 map) ──────────────────────────────────────────
  //
  // Kyle, 2026-08-16: "I will take your recommendation, A and B." A now, B at graduation.
  //
  // Before this a draft's only foreign key was supplierId — it referenced NOTHING in the
  // lead -> visit -> estimate -> account chain, so a priced draft had no owner and the lead
  // that produced the work stayed open forever. These three answer "which job was this?".
  //
  // ALL NULLABLE, ON PURPOSE, AND THAT IS THE DESIGN RATHER THAN A COMPROMISE:
  //   * the nav entry stays context-free — Kyle prices speculatively and tests daily, and
  //     Option C (job-context only) was rejected for exactly that reason;
  //   * nothing is backfilled and nothing becomes required, so the change is reversible;
  //   * the choice of WHICH anchor is authoritative (lead vs visit vs customer) is deferred —
  //     all three are recorded when known, and Option B settles the question at graduation.
  //
  // onDelete: SetNull, not Cascade: deleting a job must not delete the estimate work done
  // for it. The draft survives with a null link and says "unattached".
  leadId        String?
  customerId    String?
  visitId       String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visit         Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  // The supplier the tech picked in the field. Kyle 2026-08-08: "the tech in the field
  // decides the best location to purchase from and builds the quote with that supplier
  // selected." Cost resolves HERE and nowhere else — no fallback to another supplier.
  supplierId    String
  jobDescription String?
  scenarioRef   String?  // e.g. "S-2026-08-11-G" when recomposing a recorded job
  // ── Option mode (Kyle, 2026-08-25) ──
  // false = all-that-apply (the default: options ADD — A + B + C).
  // true  = one-or-the-other ("a 10 foot option, a 20 foot option and a 30 foot
  // option… they cannot be additive") — the customer picks exactly ONE.
  exclusiveOptions Boolean @default(false)
  status        String   @default("draft") // draft | finalized
  finalizedAt   DateTime?
  // Snapshot of the rate this draft was computed against, and whether it was provisional.
  // Stored so a draft priced at $201.34 cannot be silently reinterpreted at $150 later.
  billedLaborRate   Float?
  rateProvisional   Boolean @default(false)
  provisionalReason String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         PriceBookDraftLine[]
  questions     PriceBookDraftQuestion[]
  issued        IssuedEstimate[]

  @@index([status, createdAt])

  /// ── CHANGE ORDER (Kyle, 2026-08-19) ──
  ///
  /// "Nothing will revise the already signed quote. If a change is deemed necessary... a change
  ///  order is created. The same job ID only with additional sections that add the work or remove
  ///  the work... This means we should be able to do a negative count on the line items."
  ///
  /// Set when this draft exists to change an estimate that has already been signed. It is the ONLY
  /// condition under which a negative line quantity is accepted — on an ordinary estimate a
  /// negative count is a typo, and quoting one would be a mistake nobody catches until the total
  /// looks wrong.
  changeOrderForId String?
  changeOrderFor   IssuedEstimate? @relation("ChangeOrders", fields: [changeOrderForId], references: [id], onDelete: SetNull)

  /// Kyle's names and short descriptions for each option, editable until issue (2026-08-20).
  optionMeta    PriceBookDraftOption[]

  /// "military" | "senior" | "custom" | null (2026-08-22; custom 2026-09-01). Kyle: "military
  /// discount at 5%, senior citizen discount at 5%". One per estimate, never stacked — a customer
  /// is not 10% off for being both.
  discountType  String?
  /// The custom percentage (Kyle, 2026-09-01: "enter a percentage and apply" — a price match).
  /// Only meaningful with discountType "custom"; uncapped, bounded at 50%.
  discountPercent Float?

  /// Walkthrough photos (2026-08-22). Cascade: photos of a deleted draft mean nothing.
  photos        DraftPhoto[]
}

// What the AI could NOT match to an atomic.
//
// "Never make up a number" applied to scope: an item the model cannot place in the catalog
// becomes a QUESTION FOR THE TECH, never a guessed atomic or a guessed quantity. These block
// finalize until a human resolves them, so the failure mode of an unmatched item is a visible
// unanswered question rather than a quietly short quote.
model PriceBookDraftQuestion {
  id             String    @id @default(cuid())
  draftId        String
  // The model's own words for what it could not place, e.g. "customer said 'that weird
  // outdoor plug by the pool' — no atomic matches with confidence".
  question       String
  rawText        String?   // the tech/customer phrasing this came from
  raisedBy       String    // "ai:gpt-5.1"
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  draft          PriceBookDraftEstimate @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, resolvedAt])
}

/// Which of the three options a line belongs to. (2026-08-19)
///
/// Kyle: "Option A - The direct Quote for what the client called for. Option B - Code Violations
/// or Hazards found during the Electrical assessment. Option C - Any recommendation beyond option
/// A and B that the tech finds necessary to offer. Each option gives its total separately."
///
/// The labels stay literally "Option A/B/C" on the customer's page — his ruling, 2026-08-19.
enum PriceBookOption {
  A
  B
  C
}

model PriceBookDraftLine {
  id             String                  @id @default(cuid())
  draftId        String
  itemId         String
  quantity       Float
  quantitySource PriceBookQuantitySource
  // Per LINE, never per estimate. Kyle 2026-08-11: "give the tech an option to check
  // difficult or very difficult on the assembly or line item… This gets rid of the
  // assumption." A blanket estimate-level difficulty is exactly what that ruling removed.
  difficulty     PriceBookDifficulty     @default(NORMAL)
  location       String?
  note           String?
  sortOrder      Int                     @default(0)
  // Defaults to A so every existing line becomes "what the client called for", which is what
  // they all were before there was anywhere else to put them.
  option         PriceBookOption         @default(A)

  // ── Propose / confirm ──
  //
  // DEFAULT IS **PROPOSED**, DELIBERATELY. The two failure directions are not symmetric: a
  // human line that accidentally defaults to PROPOSED shows up as an unconfirmed row the
  // operator can see and click, while an AI line that accidentally defaults to CONFIRMED puts
  // a number the model chose into a customer's price. Fail toward "no money moves".
  // The human path (atomicEstimateService.addLine) sets CONFIRMED explicitly.
  state          PriceBookLineState      @default(PROPOSED)
  // "ai:gpt-5.1" for a model proposal; null when a human entered the line directly.
  proposedBy     String?
  // The model's stated reason for suggesting this line. Kept so a confirmation is informed.
  proposalReasoning String?
  proposedAt     DateTime?
  // Who confirmed, and when. Set only by the PIN-authenticated human surface.
  confirmedBy    String?
  confirmedAt    DateTime?
  // True when the human changed quantity/difficulty/source before confirming.
  editedBeforeConfirm Boolean            @default(false)

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  draft          PriceBookDraftEstimate  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  atomic         PriceBookAtomic         @relation(fields: [itemId], references: [itemId], onDelete: Restrict)

  @@index([draftId])
  @@index([draftId, state])
  @@index([draftId, option])
  @@index([itemId])
}
// ─── ISSUED ESTIMATES — the customer-facing artifact (P027) ──────────────────
//
// Kyle, 2026-08-17: "get the estimates working to the point where I can email the customer
// and have them sign an estimate in the app."
//
// WHY A NEW MODEL RATHER THAN THE LEGACY `Estimate`. Three reasons, none cosmetic:
//   1. `Estimate.visitId` and `.propertyId` are REQUIRED. A price-book draft may legitimately
//      carry no job at all — P024 made all three context columns nullable on purpose, because
//      Kyle prices speculatively every day. Graduating an unattached draft into a model that
//      demands a visit would mean inventing one.
//   2. The legacy row's numbers are live: option subtotals recompute from assemblies. What gets
//      emailed and signed must be FROZEN. A signed artifact that can move is not a record.
//   3. Its lifecycle is draft/locked around assemblies; this one is draft -> sent -> viewed ->
//      signed with a customer token and a revision chain.
// Legacy `Estimate`, `EstimateOption` and `EstimateItem` are untouched and still readable.
//
// T5 (the P010 transition map's open row) is closed HERE: `IssuedEstimateLine.itemId` points at
// `PriceBookAtomic`, the current catalog, through its own foreign key. Kyle's reorganized units
// swap in later as a data migration — the flow reads no atomic ID it did not get from the draft.
model IssuedEstimate {
  id             String   @id @default(cuid())
  // House numbering, continuing the issued PDFs (…2026-1010). Shared across revisions of the
  // same estimate; `revision` is what distinguishes them.
  number         String
  revision       Int      @default(1)
  // draft | sent | viewed | signed | void
  status         String   @default("draft")
  // The customer's ONLY credential: 32 random bytes, hex. Not a cuid — cuids embed a counter
  // and a timestamp, so one issued link would narrow the search space for the next.
  token          String   @unique

  // ── Provenance ──
  // Restrict, not Cascade or SetNull: a draft that has been issued to a customer is not
  // deletable. The issued estimate is the business record and it must keep pointing at what
  // produced it.
  draftId        String
  draft          PriceBookDraftEstimate @relation(fields: [draftId], references: [id], onDelete: Restrict)

  // ── Revision chain. Editing after send never mutates — it supersedes. ──
  supersedesId   String?  @unique
  supersedes     IssuedEstimate?  @relation("EstimateRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   IssuedEstimate?  @relation("EstimateRevision")

  // ── THE ACCOUNT SPINE (P029). ────────────────────────────────────────────────────────
  //
  // Kyle, 2026-08-18: "All of it links to their account… if they have multiple addresses on
  // file it needs to link to the address that we are working at."
  //
  // REQUIRED, and real foreign keys. Before this an issued estimate could be created with no
  // owner at all — which is the P020 disjoint-graph defect reaching the one artifact a customer
  // actually signs. Account-level linkage alone does not satisfy the ruling: an account with
  // three properties needs to know WHICH ONE the work is at, so the address is required too.
  //
  // `account` is the `Customer` model — the server still calls it Customer, the client and Kyle
  // both say "account", and they are the same row. `serviceAddress` is the existing `Property`
  // model. Neither is a new entity; adding parallel `accountId`/`addressId` columns beside the
  // ones that already mean this would create a second source of truth for the same fact.
  //
  // onDelete: Restrict on both — an account or an address with an issued estimate against it is
  // not deletable. The estimate is a business record and it must keep naming who and where.
  customerId       String
  serviceAddressId String
  account          Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Named `serviceProperty`, not `serviceAddress`: the string column of that name already
  // exists a few lines below and is the FROZEN TEXT of the address as it read at issuance.
  // They are a pair and both are load-bearing — the id is the live link the account page
  // queries, the text is what the signed document says and must never move.
  serviceProperty  Property @relation(fields: [serviceAddressId], references: [id], onDelete: Restrict)

  // The lead this traces back to, and the visit the draft came from. Still nullable and still
  // plain columns: they are provenance, not the spine.
  leadId         String?
  visitId        String?
  // The job created when the customer signed (P029 scope 4). Plain column: the job points back
  // through its own account and property, so a relation here would only duplicate that edge.
  jobVisitId     String?
  customerName   String
  customerEmail  String?
  customerPhone  String?
  serviceAddress String?

  title          String
  scopeText      String?
  includedText   String?
  // P031: the generator sizing one-pager, SNAPSHOT at issuance like every other
  // customer-facing fact on this row. Set only when a human chose to attach it
  // while issuing (propose-only posture) — null renders nothing.
  generatorJson  String?
  validDays      Int      @default(30)

  // ── Money, SNAPSHOT, flat. NO HOURS AND NO RATES ARE STORED ON THIS ROW.
  // Kyle 2026-08-17: "Never show labor hour estimate to the customer." The hours exist in the
  // draft and the workbook; what graduates is the flat price they produced. A column that does
  // not exist cannot leak into a template.
  workSubtotal   Float
  tripCharge     Float    @default(0)
  tripWaived     Boolean  @default(false)
  total          Float

  // ── Audit ──
  createdAt      DateTime @default(now())
  createdBy      String?
  sentAt         DateTime?
  sentBy         String?
  sentTo         String?
  firstViewedAt  DateTime?
  signedAt       DateTime?
  signerName     String?
  signerIp       String?
  signerUserAgent String?
  consentText    String?
  // How the signature was collected: "in_person" (customer signed on the operator's device at
  // the job — Kyle's FIRST option, P028) or "email" (customer opened the tokenized link, P027).
  // Null on estimates issued before P028. Everything else about a signature — the lock, the
  // audit line, the status, the owner notification — is identical between the two channels;
  // this column records only which door it came through.
  signedChannel  String?
  voidedAt       DateTime?
  voidReason     String?

  lines          IssuedEstimateLine[]
  events         IssuedEstimateEvent[]

  @@unique([number, revision])
  @@index([status, createdAt])
  @@index([draftId])
  // Declared here as well as created in the P029 migration — the account page and the chain view
  // both query by these, and an index that exists in the database but not the schema reads as
  // drift the next diff will try to drop.
  @@index([customerId])
  @@index([serviceAddressId])

  /// Copies filed against the account — the signed agreement (2026-08-20).
  /// The DRAWN signature, as a PNG data URL (Kyle, 2026-08-20: "I want the signiture to be
  /// drawn not typed"). The typed name is kept alongside it — it is how the signature is
  /// searched and addressed; the drawing is what was actually made.
  signatureImage String?

  documents      Document[]

  /// Drafts raised to change this estimate after it was signed.
  changeOrders   PriceBookDraftEstimate[] @relation("ChangeOrders")

  /// The named options presented to the customer, frozen at issue (2026-08-20).
  options        IssuedEstimateOption[]

  /// What the job-level material check did at issue, as JSON keyed by option (2026-08-21).
  ///
  /// Frozen with the prices it explains, for the same reason the prices are frozen: the company
  /// copy prints it, and a signed document must keep saying what it said. Null on estimates
  /// issued before the check existed — absent, not "no cap", which is a claim.
  materialCapsJson String?

  /// THE THIRD GATE's result for the options the customer actually took, frozen at SIGNATURE
  /// (2026-08-22) — not at issue, because the discount depends on a selection that does not exist
  /// until they tick. Unsigned renders recompute it live from the frozen lines; the moment a name
  /// goes on the document this is written, so a later edit to the bands in code can never restate
  /// a signed price. Null on estimates signed before the gate existed.
  comboCapJson String?

  /// The discount programme this estimate carries — "military" | "senior" | "custom" | null
  /// (2026-08-22; custom 2026-09-01).
  discountType String?
  /// The custom percentage, frozen from the draft at issue so a later draft edit cannot restate
  /// a document already in a customer's hands.
  discountPercent Float?

  /// Option mode, frozen from the draft at issuance (Kyle, 2026-08-25).
  /// false = options ADD (all that apply). true = one-or-the-other — the
  /// customer signs for exactly ONE option, enforced at signature.
  exclusiveOptions Boolean @default(false)

  /// The discount as APPLIED, frozen at signature: {type, rate, cap, base, amount}. Frozen then
  /// and not at issue because the amount is 5% of what the customer SELECTS, capped at $250 —
  /// Kyle: "Off of the whole job but gets capped at $250" — and the selection does not exist
  /// until they sign. Unsigned surfaces recompute it live from the frozen lines.
  discountJson String?

  /// The job-level band SCHEDULE in force when this was issued, as JSON (2026-08-22).
  ///
  /// Frozen for the same reason the prices are. Kyle tunes these bands in Rate Config now, and
  /// without this an already-issued estimate would recompute its combination discounts against
  /// whatever schedule was current — so retuning the bands would silently restate a price he had
  /// already quoted, on a page a customer may be looking at. Null on estimates issued before the
  /// schedule was configurable; the code's own default stands for those.
  jobBandsJson String?

  /// WHICH OPTIONS THE CUSTOMER ACTUALLY BOUGHT.
  ///
  /// Kyle, 2026-08-20: "the options are not persisting into the pdf or allowing to pick and
  /// choose between them. Only adding them all together."
  ///
  /// Empty means nothing has been chosen yet, which is the honest state of an unsigned estimate
  /// and is NOT the same as "all of them". The customer ticks options, the total is computed from
  /// the ticks, and what they ticked is recorded here when they sign — so the signed agreement
  /// says what was bought rather than what was offered.
  selectedOptions PriceBookOption[]
}

/// One option as it was presented to the customer — the thing they tick.
///
/// Frozen at issue like the lines are, and for the same reason: the price book moves, the draft
/// can be edited, and a signed agreement has to keep saying what it said when it was signed.
///
/// `subtotal` is stored rather than re-summed from the lines. The lines are already frozen, so the
/// two agree today — but storing it means a later change to how lines are grouped or priced cannot
/// silently restate the number a customer put their name to.
model IssuedEstimateOption {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    IssuedEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  option      PriceBookOption

  /// What Kyle renamed it to at the review screen, e.g. "Exterior pathway lights".
  ///
  /// Kyle, 2026-08-20: "It would be nice to be able to rename the options at the review screen in
  /// order to specify the scope of work to the job being quoted."
  ///
  /// Null means it was never renamed and the document falls back to the bare letter — the
  /// fallback lives in the renderer rather than being baked into every row at issue time.
  label       String?

  /// The short description under the name. Sales context, customer-facing.
  note        String?

  /// What this option costs on its own. Excludes the trip charge, which is charged once across
  /// the whole combination rather than once per option.
  subtotal    Float
  lineCount   Int      @default(0)

  @@unique([estimateId, option])
  @@index([estimateId])
}

/// Kyle's names for the options while the estimate is still a draft.
///
/// Separate from the frozen copy above: this one is editable right up until issue, and the issued
/// row is the snapshot. A draft that is revised and re-issued carries its names forward without
/// the old signed document changing.
/// A walkthrough photo, attached to a draft (2026-08-22).
///
/// Kyle: "there is no capability to take photos right now."
///
/// BYTES LIVE IN THE DATABASE, deliberately. Railway wipes the filesystem on every deploy — the
/// same reason signed copies render from the estimate instead of reading generated/. A photo that
/// survives until the next release is a photo that was never really stored. Client downscales
/// before upload; the server enforces the cap so the table cannot be filled by accident.
///
/// NOT sent to any AI. P012 seam: attach-only, no model egress — that is a separate decision
/// Kyle has not made.
model DraftPhoto {
  id        String   @id @default(cuid())
  draftId   String
  draft     PriceBookDraftEstimate @relation(fields: [draftId], references: [id], onDelete: Cascade)
  mime      String
  bytes     Bytes
  size      Int
  note      String?
  createdAt DateTime @default(now())

  @@index([draftId])
}

model PriceBookDraftOption {
  id        String   @id @default(cuid())
  draftId   String
  draft     PriceBookDraftEstimate @relation(fields: [draftId], references: [id], onDelete: Cascade)
  option    PriceBookOption
  label     String?
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([draftId, option])
  @@index([draftId])
}

// One priced line as the customer sees it: a description, a quantity, and a flat price.
//
// Every display value is SNAPSHOT on this row. The `atomic` relation is provenance — it says
// which catalog row produced the line — and the render never reads through it. That is what
// makes a signed estimate reproducible byte-for-byte after the catalog moves underneath it.
model IssuedEstimateLine {
  id           String   @id @default(cuid())
  estimateId   String
  itemId       String
  description  String
  quantity     Float
  // Flat sell price for ONE unit: the line's labour dollars and material sell, already combined.
  unitPrice    Float
  lineTotal    Float
  sortOrder    Int      @default(0)

  // ── What the COMPANY copy needs, frozen with everything else (2026-08-19) ──
  //
  // Kyle: "the labor units and line item pricing will have to show for the company copy. The goal
  // is to have a material list and labor unit assesment for the puprose of ordering and scheduling
  // the job." None of that could be produced from this row before: it carried a combined unit
  // price and nothing else, so a company document would have had to be rebuilt from the DRAFT —
  // which can move, while an issued estimate must not. A record of what was sold has to contain
  // what was sold.
  //
  // `option` matters just as much: without it the frozen estimate forgets which option each line
  // belonged to, and an estimate presented as three options would come back as one flat list.
  option       PriceBookOption @default(A)
  /// Labour hours for this line, at its difficulty. Scheduling is planned against these.
  laborHours   Float?
  /// Material sell for this line — column F, what the customer is charged. Null and 0 differ:
  /// 0 is customer-supplied, null is unknown.
  materialSell Float?
  /// Material COST — column E, what it costs Red Cedar. Kyle, 2026-08-20: "In the estimate
  /// column E is what we see to track spending." Frozen alongside the charge so the company copy
  /// can show both and the margin on a signed job is a fact rather than a re-derivation.
  materialCost Float?
  /// Priced FLAT from Kyle's own sell columns (his catalog tab / in-app items). The combination
  /// discount recomputed from frozen lines skips these — their price is the book's price
  /// (2026-08-31). Frozen here so the exemption never depends on the live catalog.
  flatPriced   Boolean  @default(false)
  /// Continuous-length material (wire, cable, conduit) — the only lines the job-level material
  /// cap reads (Kyle, 2026-08-31, "split the difference"). Frozen so the combination discount
  /// recomputed at signing and on the customer page uses the same population as the issue.
  /// Defaults true so estimates issued before the rule keep the numbers they were issued with.
  inMaterialCap Boolean @default(true)

  estimate     IssuedEstimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  atomic       PriceBookAtomic @relation(fields: [itemId], references: [itemId], onDelete: Restrict)

  @@index([estimateId])
  @@index([itemId])
}

// Append-only audit trail. The columns on IssuedEstimate carry the CURRENT state; this carries
// the sequence, including re-sends, which a single `sentAt` cannot represent.
model IssuedEstimateEvent {
  id           String   @id @default(cuid())
  estimateId   String
  // created | sent | viewed | signed | voided | superseded
  type         String
  at           DateTime @default(now())
  // "human:crm-session" for an operator action, "customer" for a token action.
  actor        String
  detail       String?

  estimate     IssuedEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, at])
}
