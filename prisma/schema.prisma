  trendDirection            String?   // stable | worsening | improving
  internalNotes             String?
  followUpDueDate           DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([propertyId])
  @@index([followUpDueDate])
}

