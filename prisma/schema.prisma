// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  priceBookDrafts   PriceBookDraftEstimate[]
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  // Tri-state SMS consent, carried from the lead at conversion. true = opted in
  // (web form checkbox), false = explicitly declined or texted STOP, null =
  // never asked (phone leads, manual entries). sendSms() only sends to a known
  // Customer/Lead when this is true — null and false are both "not opted in"
  // (the website checkbox is the only opt-in channel) — see services/twilio.ts.
  smsConsent  Boolean?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
  visits      Visit[]
  issuedEstimates IssuedEstimate[]
  // Marks the internal price-book testing account (P029). Kyle, 2026-08-18: "Speculative
  // pricing may exist only for testing the price book but should be a planned deletion."
  // Rows under a test account are excluded from funnel counts and the Estimates chain view,
  // and the whole account deletes in one action — on Kyle's word, never on a schedule.
  isTestAccount Boolean  @default(false)
  healthInspections HealthInspection[]
  contacts    CustomerContact[]
  payments    Payment[]

  @@index([phone])
}

// Additional labeled emails/phones on an account (Kyle, 2026-08-25: "the
// ability to store multiple email addresses and phone numbers, to resend
// estimates and select a specific email to resend it to"). The Customer row's
// own email/phone stay the PRIMARY — these are the spouse's cell, the work
// email, the property manager. Send pickers list primary + these; inbound SMS
// matching searches these numbers too, so a text from the spouse still lands
// on the account.
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  label      String   // "Spouse — cell", "Work email", "Property manager"
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([phone])
}

model Property {
  id                     String         @id @default(cuid())
  customerId             String
  name                   String
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  postalCode             String
  notes                  String?
  occupancyType          String         @default("residential") // residential | commercial
  // Explicit office override for the code jurisdiction at this address. Null means
  // "derive it" — see services/jurisdictionResolver.ts, which falls back to the
  // ZIP-keyed territories setting, then a city map. The field PWA must never guess.
  jurisdictionId         String?
  // ── Protocol v2 code-era resolution (§1.3) ──
  // The AHJ's enforced NEC edition, set at intake. Null = resolve via
  // jurisdictionResolver's edition mapping. NOTHING may hardcode an edition.
  ahjCodeEdition         String?  // "2017" | "2020" | "2023"
  // Drives the no-FAIL-against-later-code rule (v2 hard rule 5): no finding may
  // be classified FAIL against a requirement introduced after this date, absent
  // an explicitly retroactive requirement.
  estimatedInstallYear   Int?
  conductorMaterialService String? // copper | aluminum | copper_clad_aluminum | unknown
  conductorMaterialBranch  String? // copper | aluminum | mixed | unknown
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  systemSnapshot         SystemSnapshot?
  visits                 Visit[]
  estimates              Estimate[]
  issuedEstimates        IssuedEstimate[]
  healthInspections      HealthInspection[]
  findings               PropertyFinding[]
  documents              Document[]
  enclosures             Enclosure[]

  // Prisma doesn't index relation scalars on Postgres, and every account read
  // fans out by customerId — the account summary, the customer list, and now
  // add/edit/delete-address, which all re-read the account afterwards.
  //
  // Deliberately NO unique constraint on the address. Normalising well enough for
  // a key ("St" vs "Street", unit numbers, case) is its own project, and a false
  // positive would block a legitimate second unit at one street address — a
  // duplex or an ADU, which is exactly the multi-address case this supports.
  // Near-duplicates are surfaced as a client-side warning instead.
  @@index([customerId])
}

// ─── Finding ledger ────────────────────────────────────────────────────────
//
// What the Health Record was missing: it could show what was *known* at an
// address, never what was known *and fixed*. That gap is both a remediation
// close the business needs and a liability the business carries — a written,
// code-cited defect report is legal notice, and an owner who ignores it makes
// the report the plaintiff's exhibit unless the record can also show the cure.
//
// Two tracks share this table. `defect` (FAIL) ends in *corrected* and produces
// a cure certificate. `upgrade` (MONITOR / BELOW_STANDARD) ends in *replaced or
// upgraded* — wear tracked against a published service life, or work that meets
// code but not our standard. Both are documented whether or not the work is done.
model PropertyFinding {
  id             String   @id @default(cuid())
  propertyId     String
  customerId     String
  itemId         String // checklist item, e.g. "C4"
  // Which enclosure. NOT nullable: Postgres treats NULLs as distinct in a unique
  // index, so a nullable column would silently duplicate every Phase 1 row.
  // Not defaulted to a real location either — that would assert a place the
  // technician never recorded.
  locationKey    String   @default("_default")
  cycle          Int      @default(1) // nth time this has been documented here

  track          String // defect | upgrade

  // ── Snapshot taken when the finding opened. Never re-derived: a 2017-NEC
  // finding must not be recited under 2023 because the county adopted it later.
  title          String
  section        String?
  citationsJson  String // string[]
  jurisdictionId String
  severity       String // FAIL | MONITOR | BELOW_STANDARD
  gradedState    String?
  critical       Boolean  @default(false)
  findingText    String
  resolutionNote String?

  // ── Upgrade track only ──
  expectedEolYear Int?
  followUpAt      DateTime?

  status String @default("open")
  // defect  : open | scheduled | corrected | declined | superseded
  // upgrade : open | scheduled | upgraded  | declined | superseded

  openedInspectionId   String
  openedVisitId        String
  openedAt             DateTime
  openedByTechnicianId String?

  lastObservedInspectionId String?
  lastObservedAt           DateTime?
  observedCount            Int       @default(1)
  // A later PASS is evidence, not proof of what was corrected, by whom, or when.
  // It queues the row for close-out; only the licence holder cures it.
  verifiedPassInspectionId String?
  verifiedPassAt           DateTime?

  scheduledVisitId String?
  scheduledAt      DateTime?

  resolvedAt             DateTime?
  resolutionMethod       String? // corrected | replaced | upgraded | equipment_removed | verified_prior_repair
  resolvedByParty        String? // red_cedar | owner_self | third_party
  resolvedByPartyName    String?
  resolvedByVisitId      String?
  resolvedByTechnicianId String?
  resolutionDetail       String?
  certificateDocId       String?

  declinedAt         DateTime?
  declinedByName     String?
  declinedByRelation String? // owner | tenant | property_manager — legally load-bearing
  declinedVerbatim   String?
  declinedChannel    String?
  declinationDocId   String?

  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  property  Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events    PropertyFindingEvent[]

  @@index([propertyId, status])
  @@index([customerId, status])
  @@index([track, status, followUpAt])
}

// One run of the Article 220 capacity question: "can this existing service take
// the load the customer wants to add?"
//
// Client-generated UUID id, same rationale as HealthInspection — a technician
// runs this in a crawlspace and the offline queue retries the push.
//
// 220.83 is the default and the one used constantly. 220.87 is a separate,
// explicitly-priced service line (recorder rental + return visit + a 30-day
// wait) and is only reachable when a 220.83 check has already failed AND the
// customer has said they want to avoid the upgrade cost.
model CapacityCheck {
  id             String   @id // client-generated UUID
  visitId        String?
  propertyId     String
  customerId     String
  technicianId   String?
  method         String // "220.83" | "220.87"
  serviceAmps    Int
  serviceVoltage Int      @default(240)
  floorAreaSqFt  Int      @default(0)
  variant        String? // A | B — 220.83 only
  newLoadLabel   String?
  calculatedAmps Float
  loadPct        Float
  fits           Boolean
  // 220.87 only: false when the demand data does not meet the code's own
  // requirements (short window, wrong interval). A number from unqualified data
  // is worse than no number.
  qualifies      Boolean  @default(true)
  inputJson      String
  resultJson     String
  // Set when a later check replaces this one, so a superseded calculation stays
  // readable rather than being edited into something that was never issued.
  supersedesId   String?
  // Set when the calculation was taken during a Health Record rather than run
  // standalone. Worth distinguishing: one was done with the panel open and the
  // plates read, the other in two minutes on the phone, and they are not the
  // same quality of document even when they agree.
  sourceInspectionId String?
  documentId     String?
  // 220.87 study tracking — the two visits it takes and when the window closes.
  studyInstallVisitId String?
  studyRemovalVisitId String?
  studyOrderedAt      DateTime?
  // P031 generator sizing recommendation produced alongside this calculation
  // ({recommendation, fuel, softStart, includeInEstimate}). Nullable — most
  // calculations never ask the generator question.
  generatorJson  String?
  createdAt      DateTime @default(now())

  @@index([propertyId, createdAt])
  @@index([visitId])
  @@index([sourceInspectionId])
}

// Append-only history. Every status change and every re-observation lands here,
// so the record can show the sequence — documented, declined, recurred, corrected
// — which is the part that actually defends anybody.
model PropertyFindingEvent {
  id           String   @id @default(cuid())
  findingId    String
  fromStatus   String?
  toStatus     String
  actorType    String // technician | owner | system
  actorId      String?
  actorName    String
  visitId      String?
  inspectionId String?
  documentId   String?
  note         String?
  createdAt    DateTime        @default(now())
  finding      PropertyFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  // Replaying the same push must not double-log. The sync queue retries.
  @@unique([findingId, inspectionId, toStatus])
  @@index([findingId, createdAt])
}

model SystemSnapshot {
  id                     String    @id @default(cuid())
  propertyId             String    @unique
  serviceSummary         String?
  panelSummary           String?
  groundingSummary       String?
  wiringMethodSummary    String?
  deficienciesJson       String?
  changeLogJson          String?
  updatedAt              DateTime  @updatedAt
  property               Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Visit {
  priceBookDrafts   PriceBookDraftEstimate[]
  id                     String            @id @default(cuid())
  propertyId             String
  customerId             String
  mode                   String
  purpose                String?
  visitDate              DateTime          @default(now())
  notes                  String?
  // ── Job tracking fields (Phase 1 data model) ──
  status                 String            @default("estimate") // estimate | contracted | scheduled | in_progress | completed | cancelled
  jobType                String?           // e.g. "Panel Upgrade", "Lighting Install"
  estimatedJobLength     Float?            // hours — used for calendar blocking
  estimatedDurationDays  Int?              // working days for calendar blocking
  estimatedDurationHours Float?            // hours within each day
  scheduledStart         DateTime?
  scheduledEnd           DateTime?
  googleEventId          String?
  contractedAt           DateTime?
  // When the job was closed out (Kyle, 2026-08-25: "Lead → appointment →
  // Estimate → job → job complete → stored and tracked"). The labor-tracking
  // timestamp; clock in/out is a later phase and hangs off this same visit.
  completedAt            DateTime?
  // ── The handoff (Phase 4). Kyle: "admin then schedules an estimate or
  // install once that job is closed out." A completed job with nextStep null
  // sits in the office's Needs-next-step queue until someone dispositions it:
  // archived | followup_booked. Null on everything not yet completed.
  nextStep               String?
  nextStepAt             DateTime?
  // ── Customer appointment confirmation (dual-channel email + SMS) ──
  confirmationStatus     String            @default("unconfirmed") // unconfirmed | confirmed | reschedule_requested | cancel_requested
  confirmationToken      String?           @unique // public token for the /confirm/:token page
  confirmedAt            DateTime?
  confirmationChannel    String?           // email_link | sms_reply | crm
  reminderSentAt         DateTime?
  estimatedCost          Float?
  actualMaterialCost     Float?            @default(0)
  laborHours             Float?            @default(0)
  overheadAllocation     Float?            @default(0)
  revenue                Float?
  // ── Timestamps & relations ──
  createdAt              DateTime          @default(now())
  property               Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer               Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerRequest        CustomerRequest?
  observations           Observation[]
  findings               Finding[]
  limitations            Limitation[]
  recommendations        Recommendation[]
  estimates              Estimate[]
  documents              Document[]
  materialOrders         MaterialOrder[]
  assignments            VisitAssignment[]
  healthInspections      HealthInspection[]
  visitPhotos            VisitPhoto[]
  timeEntries            TimeEntry[]

  @@index([customerId, visitDate])
  @@index([status, scheduledStart])
}

// The time clock (Phase 5, Kyle 2026-08-25: "we need to have a time stamp for
// labor tracking with a clock in button too"). One row per punch; clock-out
// closes the open row and rolls the sum into Visit.laborHours, which is what
// job profitability's labor line reads.
model TimeEntry {
  id           String    @id @default(cuid())
  visitId      String
  technicianId String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  minutes      Float?
  visit        Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([technicianId, endedAt])
}

// ─── Health Record (field inspection PWA) integration ──────────────────────

model Technician {
  id             String   @id @default(cuid())
  name           String
  // Company Google Workspace address (assigned at onboarding). Doubles as the
  // tech's Google Calendar ID: availability reads and event invites use it
  // directly — see services/techCalendars.ts.
  email          String?
  phone          String?
  employeeNumber String?  @unique // internal payroll/identification ID — used by voice agent to authenticate field staff
  role           String   @default("technician") // technician | supervisor | admin
  // Kyle, 2026-08-25: "This has been reviewed and a whole inspection was done,
  // that was the review." When the inspecting tech holds the license, the
  // contractor-review requirement is satisfied by the inspection itself — no
  // false "pending" state. The gate stays armed for techs without this flag.
  licenseHolder  Boolean  @default(false)
  accessToken    String   @unique // bearer token used by the field PWA
  isActive       Boolean  @default(true)
  // Set by the "verify calendar access" probe on the Team page. Google's
  // freebusy API silently OMITS calendars the token can't read — without this
  // flag an unshared calendar looks identical to a perfectly free one.
  calendarShared Boolean  @default(false)
  createdAt      DateTime @default(now())
  assignments    VisitAssignment[]
  healthInspections HealthInspection[]
  visitPhotos    VisitPhoto[]
}

// Flexible company configuration store — license info, operating territories,
// utility providers, hours, legal/warranty text. One row per section key; the
// value is a JSON document owned by the Settings UI. Key-value keeps schema
// churn out of company-profile edits.
model CompanySetting {
  key       String   @id // companyProfile | operatingHours | territories | legal
  valueJson String
  updatedAt DateTime @updatedAt
}

model VisitAssignment {
  id           String     @id @default(cuid())
  visitId      String
  technicianId String
  role         String     @default("primary") // primary | helper
  status       String     @default("assigned") // assigned | in_progress | completed
  assignedAt   DateTime   @default(now())
  completedAt  DateTime?
  visit        Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@unique([visitId, technicianId])
}

// Transactional day-claim that closes the check-then-book race between the
// availability read and the calendar write. The unique constraint on holdDate
// makes claiming a business day atomic across concurrent voice-agent calls —
// the second caller gets a conflict instead of a double-booking. Holds are
// short-lived (released after booking completes; TTL covers process crashes).
model SlotHold {
  id        String   @id @default(cuid())
  holdDate  String // YYYY-MM-DD (America/Chicago business day)
  jobId     String?
  heldBy    String // "scheduler" | "savannah" | "jerry" | "admin"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([holdDate])
  @@index([expiresAt])
}

// One row per completed PWA inspection. The id is the PWA-generated inspection
// UUID, which makes sync pushes idempotent. Versioned history: one property can
// accumulate many inspections over time (year-over-year record).
model HealthInspection {
  id                   String     @id
  visitId              String
  propertyId           String
  customerId           String
  technicianId         String?
  jurisdictionId       String
  inspectionDate       DateTime
  // v1 records carried a 0-100 headline score. It was dropped because a number
  // invites "why not 100?" instead of "what needs fixing?" — v2 reports lead with
  // the items that need correction. Kept nullable so historical reports still
  // render with the score they were delivered with.
  score                Int?
  schemaVersion        String     @default("v1") // v1 (scored) | v2 (findings-led)
  scope                String     @default("full") // full | phase1
  itemsAssessed        Int
  failCount            Int        @default(0)
  monitorCount         Int        @default(0)
  passCount            Int        @default(0)
  belowStandardCount   Int        @default(0)
  naCount              Int        @default(0)
  criticalFindingsJson String // string[] of checklist item ids
  // §3.3: the grounding claim depends on the instrument. Stored per inspection
  // so the record keeps the honest wording it was made with, forever — company
  // instrument today is the EXTECH 3-point fall-of-potential kit, but a record
  // made with a different meter must not inherit stronger language.
  groundingTestMethod  String?    // fall_of_potential_3point | clamp_on_loop | bonding_continuity
  contractorReviewed   Boolean    @default(false)
  reviewedAt           DateTime?
  reviewedBy           String?
  itemsJson            String // full ItemResult[] from the PWA
  loadCalcJson         String? // { input, result } NEC Art. 220 record
  // ── Per-section technician notes (Kyle, 2026-08-24) ──
  // [{ group, note, includeOnReport }]. Internal by default; a note reaches the
  // customer's report only when the technician promoted it with the toggle.
  sectionNotesJson     String?
  // ── On-site customer acknowledgment (Kyle, 2026-08-24) ──
  // The digital version of the paper form's signature box: findings were reviewed
  // with the customer, drawn signature captured on the technician's device.
  // Either a signature exists or ackSkippedReason says why not — absence is
  // always deliberate, never an oversight, because the record only protects
  // anyone if delivery and review can be proven later.
  customerSignerName     String?
  customerSignatureImage String? // data-URL PNG from the PWA's signature pad
  acknowledgedAt         DateTime?
  ackSkippedReason       String?
  appVersion           String?
  /// ── Revisions (Kyle, 2026-09-01) ──
  /// "Any change needs to be sent out and overwrite the original." A revision is a NEW row that
  /// names what it revises; the revised row gets supersededById and its report is re-delivered.
  /// History is never rewritten — the correction is layered on top and sent.
  revisesId            String?
  supersededById       String?
  syncedAt             DateTime   @default(now())
  visit                Visit      @relation(fields: [visitId], references: [id], onDelete: Restrict)
  property             Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer             Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician           Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  photos               InspectionPhoto[]
  deliveries           HealthReportDelivery[]
  // ── Protocol v2 structured capture ──
  items                InspectionItem[]
  gfciCoverage         GfciCoverage[]
  samplingRecords      SamplingRecord[]

  @@index([customerId, inspectionDate])
  @@index([propertyId, inspectionDate])
  @@index([revisesId])
}

// One row per health-report email actually sent — when, to what address, by whom.
// This is the delivery proof the whole product's liability posture rests on:
// a report that exists but was never demonstrably received is Kyle's word
// against the customer's, in exactly the scenario the record exists for.
model HealthReportDelivery {
  id           String   @id @default(cuid())
  inspectionId String
  documentId   String
  sentTo       String
  sentBy       String   // "owner:crm" | "tech:<technicianId>"
  sentAt       DateTime @default(now())
  inspection   HealthInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, sentAt])
}

// Photo evidence uploaded from the field PWA. Stored in Postgres (bytea) so the
// evidence rides the managed database backups — no volume configuration needed.
// The id is the PWA-generated photo UUID, making uploads idempotent.
model InspectionPhoto {
  id           String           @id
  inspectionId String
  mimeType     String
  sizeBytes    Int
  data         Bytes
  uploadedAt   DateTime         @default(now())
  inspection   HealthInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// ─── HEALTH ASSESSMENT PROTOCOL v2 (master protocol 2026-08-02) ────────────
//
// The v2 protocol turns the checklist inspection into an evidence-based,
// function-tested record: enclosures as first-class rows, structured
// measurements with companion-current validation, bus visual rubrics, GFCI
// coverage resolved by LOCATION, disclosed sampling, and versioned reference
// data. Everything here EXTENDS the existing HealthInspection — itemsJson
// remains the v1 checklist payload; v2 rows hang off the same inspection id.
//
// Liability posture is structural, not stylistic:
// - Reference data is append-only (rule 8): an inspection must reproduce the
//   spec applied on its date forever. specVersion/supersededById, no updates.
// - MONITOR recurrence lives in an INTERNAL-ONLY tracker pending counsel
//   review (§1.5); customer visibility is a per-row toggle, never assumed.
// - Torque may never be recorded for service-side energized lugs (§3.3);
//   enforced in the measurement validator, not just the UI.

// ── Reference data (versioned, append-only) ──

model PanelManufacturer {
  id     String       @id @default(cuid())
  name   String       @unique
  active Boolean      @default(true)
  models PanelModel[]
}

model PanelModel {
  id               String            @id @default(cuid())
  manufacturerId   String
  modelDesignation String
  frameType        String?
  // Zinsco, FPE Stab-Lok, fuse-era — maintained hazard list (Step 2)
  isObsoleteLine   Boolean           @default(false)
  hazardFlag       Boolean           @default(false)
  notes            String?
  manufacturer     PanelManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  torqueSpecs      TorqueSpec[]

  @@unique([manufacturerId, modelDesignation])
}

// Append-only (rule 8). A 2026 inspection must always reproduce the spec value
// applied that day — revisions create a NEW row pointing back via supersededById.
model TorqueSpec {
  id                 String      @id @default(cuid())
  panelModelId       String?     // null = generic fallback row
  conductorSizeMin   String?     // AWG/kcmil text — "14 AWG", "250 kcmil"
  conductorSizeMax   String?
  breakerRatingMinA  Int?
  breakerRatingMaxA  Int?
  torqueValue        Float
  torqueUnit         String      // in_lb | ft_lb
  sourceCitation     String
  // manufacturer_doc | cross_reference | field_reported — §7.1 requires every
  // value to carry its confidence; nothing ships as verified until checked
  // against a current official spec sheet.
  sourceConfidence   String
  verifiedSource     String?
  verificationDate   DateTime?
  specVersion        Int         @default(1)
  supersededById     String?
  createdAt          DateTime    @default(now())
  panelModel         PanelModel? @relation(fields: [panelModelId], references: [id], onDelete: Restrict)

  @@index([panelModelId])
}

// NETA MTS Table 100.18 framework (§7.2). Append-only like TorqueSpec.
model ThermalThreshold {
  id                String   @id @default(cuid())
  method            String   // comparative | absolute
  deltaTMinC        Float
  deltaTMaxC        Float?   // null = open-ended upper band
  classification    String   // MONITOR | FAIL | FAIL_IMMEDIATE
  recommendedAction String
  standardCitation  String
  specVersion       Int      @default(1)
  supersededById    String?
  createdAt         DateTime @default(now())
}

// Drives the code-era resolver (§1.3, rule 5). is_retroactive is the only
// path to a FAIL against a requirement newer than the install date.
model CodeRequirement {
  id                    String  @id @default(cuid())
  necArticle            String
  necEditionIntroduced  String  // "2017" | "2020" | "2023" | "pre2017"
  requirementType       String  // gfci_location | afci_coverage | spd | tr_receptacle | emergency_disconnect | other
  appliesTo             String  // free text: "dwelling unit service", "kitchen receptacles"...
  isRetroactive         Boolean @default(false)
  description           String

  @@index([requirementType])
}

// ── Operational data ──

// Panels AND disconnects, one model (§12.2). locationKey bridges to the
// existing PropertyFinding.locationKey and ItemResult.locationId so v1
// checklist rows and v2 enclosure rows describe the same physical thing.
model Enclosure {
  id                       String   @id @default(cuid())
  propertyId               String
  locationKey              String   // stable key shared with PropertyFinding/ItemResult
  enclosureType            String   // service_equipment | main_disconnect | main_panel | subpanel | equipment_disconnect
  disconnectSubtype        String?  // breakered | fused | non_fused_switch | pullout
  equipmentServed          String?  // "HVAC condenser", "water heater"...
  panelModelId             String?
  locationDescription      String?
  distanceFromMainFt       Float?   // drives the 50 ft SPD recommendation (Step 12)
  labelTorqueValueObserved String?  // the panel's own printed label — overrides all defaults
  labelLegible             Boolean?
  busMaterial              String?  // aluminum_tin_plated | copper_silver_flash | unknown
  // §3.3 settled policy: line side of a service main stays energized with the
  // main open. Items on such an enclosure may NEVER carry a torque record —
  // enforced by the measurement validator.
  serviceSideEnergized     Boolean  @default(false)
  retiredAt                DateTime? // replaced/removed — kept for history
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  property                 Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items                    InspectionItem[]

  @@unique([propertyId, locationKey])
  @@index([propertyId])
}

// One assessed component at one enclosure in one inspection (§12.2).
model InspectionItem {
  id                 String   @id @default(cuid())
  inspectionId       String
  enclosureId        String?
  componentType      String   // lug | breaker | bus_stab | bus_joint | bus_bar_section | neutral_bar | ground_bar | receptacle | switch | fixture | smoke_alarm | co_alarm | spd | service_entrance | weatherhead | mast | meter_base
  locationLabel      String?  // "kitchen east wall", "leg A stab 4"
  circuitNumber      String?
  busLeg             String?  // A | B
  stabPosition       Int?
  // Four states (§1.4). UPGRADE is not a defect; MONITOR feeds no defect
  // metrics and is internal-only pending counsel (customerVisible toggle).
  classification     String   // pass | fail | monitor | upgrade
  codeEditionApplied String?  // resolved edition this item was judged against
  // §3.3 applies PER TERMINATION, not per enclosure: the main lugs stay hot
  // with the main open, but branch breakers in the same panel are load-side
  // and can be de-energized and torqued. True here = this specific
  // termination remains energized — thermal + visual only, no torque record,
  // and the report prints the disclosed-scope-boundary language for it.
  serviceSideEnergized Boolean @default(false)
  techNote           String?
  customerVisible    Boolean  @default(true)
  createdAt          DateTime @default(now())
  inspection         HealthInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  enclosure          Enclosure?       @relation(fields: [enclosureId], references: [id], onDelete: SetNull)
  measurements       Measurement[]
  busVisual          BusVisualAssessment?

  @@index([inspectionId])
  @@index([enclosureId])
}

// Structured measurement with the v2 hard validation rules (§12.3) enforced in
// services/measurementRules.ts before any row is written:
//   1. thermal/stab readings require loadAmperageAtReading
//   2. comparative readings require comparativeReferenceItemId
//   3. classificationCeiling caps what a metric alone may claim
//   4. methodConditionsMet=false forces disclosure language in the report
model Measurement {
  id                         String   @id @default(cuid())
  inspectionItemId           String
  measurementType            String   // voltage_unloaded | voltage_loaded | current | source_impedance | voltage_drop_pct | torque | thermal_delta_t | thermal_absolute | stab_thermal_delta_t | grounding_resistance | receptacle_tension | circuit_current_at_reading
  measuredValue              Float
  unit                       String
  referenceValueApplied      Float?
  referenceSourceId          String?  // TorqueSpec/ThermalThreshold row id — pins the exact spec version
  referenceMethod            String?  // panel_label | manufacturer_doc | generic_fallback
  comparativeReferenceItemId String?  // what it was compared against (rule 2)
  comparativeLoadDeltaAmps   Float?
  loadAmperageAtReading      Float?   // rule 1 companion
  ambientAtReadingC          Float?
  methodStandard             String?  // "NETA MTS 100.18", "NEC 210.19(A) IN4"...
  methodConditionsMet        Boolean  @default(true)
  classificationCeiling      String   @default("pass_fail") // pass_fail | monitor_max | informational_only
  passed                     Boolean?
  createdAt                  DateTime @default(now())
  inspectionItem             InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  @@index([inspectionItemId])
}

// Structured visual rubric for bus/stab assessment (§8.5) — required capture,
// because "corrosion" without location and plating status is not a finding.
model BusVisualAssessment {
  id                String   @id @default(cuid())
  inspectionItemId  String   @unique
  corrosionLocation String   // stab_contact_patch | bar_flat_non_contact | bolted_joint | neutral_bar | ground_bar
  corrosionProduct  String?  // white_powdery | green_blue | black_brown | red_rust
  platingStatus     String   // intact | tarnished_intact | breached_localized | breached_at_contact | absent
  materialLoss      String   // none | surface_film | light_pitting | deep_pitting | erosion_deformation
  arcSignature      String   // none | spatter | rounded_melted_edges | material_transfer
  adjacentPolymer   String   // unaffected | discolored | browned_embrittled | charred
  heatTintMetal     String   // none | straw | blue_purple
  createdAt         DateTime @default(now())
  inspectionItem    InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
}

// GFCI protection resolved by LOCATION, not device (§9.2). Protection may sit
// at the panel or at an upstream device; what matters is whether the location
// that requires it is protected, judged against the code era that applies.
model GfciCoverage {
  id                  String   @id @default(cuid())
  inspectionId        String
  locationDescriptor  String   // "kitchen counter east", "exterior rear"...
  requiredAtInstall   Boolean
  requiredCurrentCode Boolean
  protectionSource    String   // none | device | upstream_device | panel_breaker
  functionTestResult  String?  // pass | fail | not_tested
  classification      String   // pass | fail | monitor | upgrade
  createdAt           DateTime @default(now())
  inspection          HealthInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// Disclosed sampling (§6). Undisclosed sampling is the indefensible kind; every
// report states what was sampled, on what basis, and tested-vs-total. Rule 6:
// a FAIL inside a sample expands that category to 100% before close.
model SamplingRecord {
  id                 String   @id @default(cuid())
  inspectionId       String
  category           String   // receptacle | torque | switch | fixture
  totalCount         Int
  testedCount        Int
  basis              String   // "one per branch circuit + 25% minimum"...
  expandedDueToFail  Boolean  @default(false)
  untestedLocations  String?  // by room, for the report
  createdAt          DateTime @default(now())
  inspection         HealthInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// INTERNAL ONLY pending counsel review (§1.5). MONITOR recurrence is tracked
// here — never surfaced in customer-facing flows. Customer acknowledgment is
// captured by signature at time of visit, not as a persistent flag.
model MonitorTracker {
  id                        String    @id @default(cuid())
  propertyId                String
