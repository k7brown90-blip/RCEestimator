// ─── ATOMIC MODEL ────────────────────────────────────────────────────────────

model AtomicUnit {
  id                   String         @id @default(cuid())
  code                 String         // LINE-001, RI-001, TRIM-D01, DM-001, etc.
  catalog              String         @default("shared") // "new_work" | "old_work" | "service" | "shared"
  category             String         // LINE, ROUGH_IN, TRIM, DEMO, PANEL, ACCESS, CIRCUIT_MOD, SURFACE, DIAG, TROUBLE, INSPECT
  name                 String
  description          String?
  unitType             String         // EA, LF, HR
  visibilityTier       Int            @default(1) // 1=user-facing, 2=conditional, 3=system-only
  baseLaborHrs         Float          @default(0)
  baseLaborRate        Float          @default(115)
  baseMaterialCost     Float          @default(0)
  necRefsJson          String?        // JSON array: ["210.8", "406"]
  necaSectionRef       String?        // NECA MLU section reference
  requiresCableLength  Boolean        @default(false) // true for LF unit types (cable, conduit, conductor)
  requiresEndpoint     Boolean        @default(false) // true for branch circuit units (triggers suggestion)
  resolverGroupId      String?        // links unit to WiringMethodResolver group key
  isActive             Boolean        @default(true)
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  estimateItems        EstimateItem[]

  @@unique([catalog, code])
}

model ModifierDef {
  id               String   @id @default(cuid())
  modifierType     String   // ACCESS, OCCUPANCY, HEIGHT, SCHEDULE, CONDITION
  value            String   // NORMAL, DIFFICULT, VERY_DIFFICULT, VACANT, OCCUPIED, STANDARD, LADDER, HIGH_WORK, AFTER_HOURS, EMERGENCY, OPEN, RETROFIT, OBSTRUCTED
  label            String
  laborMultiplier  Float    @default(1.0)
  materialMult     Float    @default(1.0)
  appliesTo        String   // ITEM, ESTIMATE
  sortOrder        Int      @default(0)
  isDefault        Boolean  @default(false)

  @@unique([modifierType, value])
}

model EstimateItem {
  id                        String          @id @default(cuid())
  estimateOptionId          String
  atomicUnitId              String
  location                  String?
  quantity                  Float           @default(1)
  // Snapshot (locked at creation — catalog changes don't affect existing items)
  snapshotLaborHrs          Float
  snapshotLaborRate         Float
  snapshotMaterialCost      Float
  // Circuit-specific inputs (required when requiresCableLength = true)
  circuitVoltage            Int?            // 120 | 240
  circuitAmperage           Int?            // 15 | 20 | 30 | 40 | 50
  environment               String?         // interior | exterior | underground
  exposure                  String?         // concealed | exposed
  cableLength               Float?          // linear feet — required for CIRCUIT/FEEDER
  needsThreeWire            Boolean?        // true for dryer/range 120/240V 3-wire endpoints
  // Resolver outputs (system-computed, not user-editable)
  resolvedWiringMethod      String?         // NM-B | MC | EMT | UF | PVC+THHN
  resolvedCableCode         String?         // WIR-001, WIR-002, etc.
  resolvedCableLaborHrs     Float?          // cable labor hours (@ $90/hr)
  resolvedCableLaborCost    Float?
  resolvedCableMaterialCost Float?
  // Computed totals
  laborCost                 Float           @default(0)
  materialCost              Float           @default(0)
  otherCost                 Float           @default(0)
  totalCost                 Float           @default(0)
  notes                     String?
  sortOrder                 Int             @default(0)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  estimateOption            EstimateOption  @relation(fields: [estimateOptionId], references: [id], onDelete: Cascade)
  atomicUnit                AtomicUnit      @relation(fields: [atomicUnitId], references: [id], onDelete: Restrict)
  modifiers                 ItemModifier[]
}

model ItemModifier {
  id               String       @id @default(cuid())
  estimateItemId   String
  modifierType     String       // ACCESS, HEIGHT, CONDITION
  modifierValue    String       // NORMAL, DIFFICULT, VERY_DIFFICULT, OPEN, RETROFIT, OBSTRUCTED, etc.
  laborMultiplier  Float        @default(1.0)
  materialMult     Float        @default(1.0)
  estimateItem     EstimateItem @relation(fields: [estimateItemId], references: [id], onDelete: Cascade)
}

model EstimateModifier {
  id              String   @id @default(cuid())
  estimateId      String
  modifierType    String   // OCCUPANCY, SCHEDULE
  modifierValue   String   // OCCUPIED, AFTER_HOURS, EMERGENCY, etc.
  laborMultiplier Float    @default(1.0)
  materialMult    Float    @default(1.0)
  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([estimateId, modifierType])
}

model SupportItem {
  id             String    @id @default(cuid())
  estimateId     String
  supportType    String    // PERMIT, UTILITY_COORD, PANEL_LABELING
  description    String
  laborHrs       Float     @default(0)
  laborRate      Float     @default(115)
  laborCost      Float     @default(0)
  otherCost      Float     @default(0)
  totalCost      Float     @default(0)
  isOverridden   Boolean   @default(false)
  overrideNote   String?
  sourceRule     String?   // rule/trigger that auto-generated this item
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  estimate       Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model Preset {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  itemsJson   String   // JSON array of preset items with unitCode, quantity, notes
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model JobType {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  occupancyDefault    String   @default("residential")
  environmentDefault  String   @default("interior")
  exposureDefault     String   @default("concealed")
  resolverProfileJson String?  // JSON config overrides for WiringMethodResolver
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
}

model Lead {
  id                String    @id @default(cuid())
  name              String
  email             String?
  phone             String?
  source            String    @default("email")   // email | phone | web | manual | referral | savannah_text | retention
  status            String    @default("new")     // "new" | "contacted" | "converted" | "lost"
  notes             String?
  // ── Address, two tracks ──
  // `address` is free text the phone/email intake fills. Conversion parses it
  // with a regex that needs exactly "line1, city, ST 12345" — a fallback that
  // exists only for those callers.
  //
  // The five structured columns are what the CRM's manual form fills, and
  // conversion consumes them verbatim with no parsing. They are all-or-nothing:
  // a lead either has a complete structured address or none, which is what stops
  // a Property being created with empty-string city/state/ZIP.
  address           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  jobType           String?
  callType          String?  // "new_job" | "warranty" | "reschedule" | "cancellation" | "estimate_followup" | "callback" | "vendor" | "referral" | "invoice" | "dispute" | "wrong_number" | "solicitation" | "other"
  referredBy        String?
  urgentFlag        Boolean   @default(false)
  warrantyCall      Boolean   @default(false)
  warrantyNote      String?
  // ── Follow-up & pipeline fields (Phase 1 data model) ──
  contactPreference String?   // "phone" | "email" | "either"
  // Tri-state: true = checked the consent box on the website form, false =
  // explicitly declined (box shown, left unchecked on a web lead), null = never
  // asked (phone/email/manual leads). This is the record A2P registration
  // attests to — the website checkbox is the only opt-in channel, so only
  // `true` clears the send gate in services/twilio.ts; null does NOT.
  smsConsent        Boolean?
  leadStatus        String    @default("new") // "new" | "booked" | "unresolved" | "planning" | "no_answer" | "lost" | "won"
  followUpDate      DateTime?
  followUpReason    String?   // "comparing_estimates" | "still_planning" | "consulting_partner" | "no_answer"
  followUpCount     Int       @default(0)
  lostReason        String?   // "price" | "timing" | "referral" | "trust" | "scope" | "other"
  lostNotes         String?   // internal only — verbatim customer feedback, never shared
  bestTimeToReach   String?   // free text, e.g. "mornings" or "after 3pm"
  // ── Existing linking fields ──
  estimateId        String?
  existingVisitId   String?
  customerId        String?
  propertyId        String?
  visitId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId])
  @@index([leadStatus, followUpDate])
  @@index([phone])
  @@index([createdAt])
}

// ─── PHASE 1 DATA MODEL — NEW MODELS ────────────────────────────────────────

model Receipt {
  id           String   @id @default(cuid())
  jobId        String?  // visit ID — null for overhead/gas not tied to a specific job
  category     String   // "materials" | "gas" | "maintenance" | "overhead"
  vendor       String?
  amount       Float
  lineItems    String?  // JSON array: [{name, qty, unit, unitCost}]
  imageUrl     String?
  // ── Capture provenance & review workflow ──
  source       String   @default("webhook") // webhook | tech_pwa | mms | manual
  status       String   @default("confirmed") // pending_review | confirmed
  technicianId String?  // who captured it (tech PWA or matched MMS sender)
  imageData    Bytes?   // original receipt photo — rides DB backups like InspectionPhoto
  imageMime    String?
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  // The account summary pulls receipts by job id across an account's whole history.
  @@index([jobId])
}

model Document {
  id           String    @id @default(cuid())
  // Nullable since the ledger: a cure certificate for work a third party did has
  // no Red Cedar visit to hang on, and inventing a synthetic Visit would pollute
  // the Jobs list and every calendar and revenue rollup built on it.
  jobId        String?   // visit ID
  propertyId   String?   // set when the document belongs to an address, not a job
  type         String    // "work_order" | "material_list" | "contract" | "change_order" | "signed" | "cure_certificate" | "upgrade_record" | "finding_declination"
  pdfUrl       String
  signedAt     DateTime?
  signedByIp   String?
  signedByName String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  job          Visit?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type])
}

model MaterialOrder {
  id         String    @id @default(cuid())
  jobId      String    // visit ID
  supplier   String
  items      String    // JSON array: [{name, qty, unit, partNumber?}]
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  job        Visit     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// Job-site photo uploaded from the tech PWA. Client-generated UUID id makes
// offline-queue retries idempotent (same pattern as InspectionPhoto). Stored
// in Postgres so evidence rides the managed backups.
model VisitPhoto {
  id           String      @id // client-generated UUID — idempotency key
  visitId      String
  technicianId String?
  mimeType     String
  sizeBytes    Int
  caption      String?
  data         Bytes
  uploadedAt   DateTime    @default(now())
  visit        Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([visitId])
}

// Audit log of every inbound SMS/MMS hitting the Twilio webhook — who it
// matched (customer / tech / Kyle / unknown) and how it was routed.
model InboundMessage {
  id        String   @id @default(cuid())
  fromPhone String
  body      String
  numMedia  Int      @default(0)
  matchType String   // kyle | customer | technician | unknown
  matchId   String?  // customerId or technicianId when matched
  handledAs String?  // confirmation_reply | tech_note | receipt | forwarded | kyle_dispatch | ignored
  createdAt DateTime @default(now())

  @@index([fromPhone, createdAt])
}

model AgentAuditLog {
  id              String   @id @default(cuid())
  action          String
  agent           String?  // "savannah" | "jerry"
  endpoint        String?
  visitId         String?
  entityType      String?
  entityId        String?
  payloadJson     String?
  responseStatus  Int?
  durationMs      Int?
  clientRequestId String?
  createdAt       DateTime @default(now())
}

// ─── System events ─────────────────────────────────────────────────────────
//
// Persistent, queryable error/event log. console.error scrolls away in Railway
// and is invisible to the coding agent auditing the system; this table is what
// scripts/readSystemEvents.ts reads (via `railway run`) when diagnosing
// production. Also the sink for the CRM's feedback box (source = "feedback"),
// so operator reports land next to the correlated errors, timestamped.
//
// Writes are fire-and-forget (services/systemEvents.ts) — logging must never
// take down the operation being logged.
model SystemEvent {
  id          String   @id @default(cuid())
  level       String   // "error" | "warn" | "info"
  source      String   // "express" | "twilio" | "google_calendar" | "feedback" | "cron" | ...
  message     String
  route       String?  // HTTP method + path when the event came from a request
  detailsJson String?  // stack trace, request context, feedback page/context
  createdAt   DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}

model AgentIdempotency {
  id              String   @id @default(cuid())
  clientRequestId String
  endpoint        String
  agent           String?  // "savannah" | "jerry"
  visitId         String?
  responseJson    String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([clientRequestId, endpoint])
}

model ChatMessage {
  id               String   @id @default(cuid())
  sessionId        String
  visitId          String?
  role             String   // "user" | "assistant"
  content          String
  openaiResponseId String?
  createdAt        DateTime @default(now())

  @@index([visitId, createdAt])
  @@index([sessionId, createdAt])
}